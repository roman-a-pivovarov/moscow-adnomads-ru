---
import Layout from "../../layouts/Layout.astro";
import { productName } from "../../content/brand";
import HistoryCards from "../../sections/history/HistoryCards.astro";
import HistoryNext from "../../sections/history/HistoryNext.astro";
import { historyUi } from "../../sections/history/copy";
---

<Layout
  title={`История московских выпусков — ${productName}`}
  description="Пять прошедших московских программ ADNOMADS: сроки, известные хосты и страницы выпусков."
  canonicalPath="/history/"
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{historyUi.overviewEyebrow}</p>
      <h1>{historyUi.homeTitle}</h1>
      <p class="lead">{historyUi.overviewLead}</p>
      <HistoryCards />
      <HistoryNext />
    </div>
  </section>
</Layout>
