---
import Layout from "../../layouts/Layout.astro";
import { editions } from "../../content/editions";
import { editionByHistorySlug, historyHref, historySlug } from "../../content/catalog";
import type { Edition } from "../../content/types";
import HistoryEdition from "../../sections/history/HistoryEdition.astro";
import { historyStory } from "../../sections/history/copy";

export function getStaticPaths() {
  return editions
    .filter((edition) => edition.status === "completed")
    .map((edition) => ({
      params: { slug: historySlug(edition) },
      props: { edition },
    }));
}

interface Props {
  edition: Edition;
}

const { edition } = Astro.props;
const current = edition ?? editionByHistorySlug(Astro.params.slug ?? "");
if (!current) {
  throw new Error(`Нет выпуска ${Astro.params.slug}`);
}

const story = historyStory(current.id);
const title = story
  ? `${story.headline} — ADNOMADS №${current.adnomadsNumber}`
  : `${current.dateLabel}, ADNOMADS №${current.adnomadsNumber}`;
const description = story?.description ?? `${current.dateLabel}, ADNOMADS №${current.adnomadsNumber}`;
---

<Layout title={title} description={description} canonicalPath={historyHref(current)}>
  <HistoryEdition edition={current} />
</Layout>
