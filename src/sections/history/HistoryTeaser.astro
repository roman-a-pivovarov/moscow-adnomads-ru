---
import { goals } from "../../content/analytics";
import HistoryCards from "./HistoryCards.astro";
import { historyUi } from "./copy";
---

<section class="section" id="history">
  <div class="container">
    <h2>{historyUi.homeTitle}</h2>
    <p class="lead">{historyUi.homeLead}</p>
    <HistoryCards />
    <p class="history-all">
      <a href="/history/" data-goal={goals.interestHistory}>{historyUi.allEditions}</a>
    </p>
  </div>
</section>

<style>
  .lead {
    margin-bottom: 0.25rem;
  }

  .history-all {
    margin: 1.25rem 0 0;
  }

  .history-all a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 700;
    text-decoration: none;
  }
</style>
