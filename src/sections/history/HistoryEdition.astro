---
import { goals } from "../../content/analytics";
import { completedEditions, hostsOf, moscowOrdinal, publicReviews } from "../../content/catalog";
import { imagesFor } from "../../content/images";
import type { Edition } from "../../content/types";
import { historyStory, historyUi } from "./copy";
import HistoryNext from "./HistoryNext.astro";

interface Props {
  edition: Edition;
}

const { edition } = Astro.props;
const story = historyStory(edition.id);
const hosts = hostsOf(edition.id);
const reviews = publicReviews().filter((item) => item.editionId === edition.id);
const others = completedEditions().filter((item) => item.id !== edition.id);
const frames = imagesFor("history", edition.id)
  .slice(0, 7)
  .map((item) => ({
    src: item.src,
    alt: item.alt,
    caption: item.caption,
    width: item.width || 960,
    height: item.height || 720,
  }));

const headline = story?.headline ?? edition.dateLabel;
---

<article class="section">
  <div class="container history-edition">
    <p class="eyebrow">
      {moscowOrdinal(edition.moscowNumber)} московский выпуск · ADNOMADS №{edition.adnomadsNumber}
    </p>
    <h1>{headline}</h1>
    <p class="history-date">{edition.dateLabel}</p>
    {story ? <p class="lead">{story.lead}</p> : null}
    {
      story?.paragraphs.map((paragraph) => <p>{paragraph}</p>)
    }
    {
      story?.stages && story.stages.length > 0 ? (
        <>
          <h2>{story.stagesTitle}</h2>
          <ol class="history-stages">
            {story.stages.map((stage) => (
              <li>
                <h3>{stage.label}</h3>
                <p>{stage.text}</p>
              </li>
            ))}
          </ol>
        </>
      ) : null
    }
    {
      story?.closing ? (
        <>
          <h2>{story.closingTitle}</h2>
          <p>{story.closing}</p>
        </>
      ) : null
    }
    {
      frames.length > 0 ? (
        <>
          <h2>{historyUi.framesTitle}</h2>
          <div class:list={["history-gallery", frames.length > 1 && "history-gallery--many"]}>
            {frames.map((frame) => (
              <figure>
                <img
                  src={frame.src}
                  alt={frame.alt}
                  width={frame.width}
                  height={frame.height}
                  loading="lazy"
                  decoding="async"
                />
                {frame.caption ? <figcaption>{frame.caption}</figcaption> : null}
              </figure>
            ))}
          </div>
        </>
      ) : null
    }
    {
      hosts.length > 0 ? (
        <>
          <h2>{historyUi.hostsTitle}</h2>
          <p>
            {edition.hostListStatus === "partial" ? historyUi.hostsPartial : historyUi.hostsComplete}
          </p>
          {story?.hostAside ? <p>{story.hostAside}</p> : null}
          <ul class="chip-list">
            {hosts.map((host) => (
              <li class="chip">{host.name}</li>
            ))}
          </ul>
        </>
      ) : null
    }
    {
      reviews.length > 0 ? (
        <>
          <h2>{historyUi.reviewsTitle}</h2>
          <ul class="history-reviews">
            {reviews.map((review) => (
              <li>
                <blockquote>
                  <p>{review.quote}</p>
                </blockquote>
                <p class="history-review-author">
                  {review.authorName}
                  {review.authorRole ? <span> · {review.authorRole}</span> : null}
                </p>
              </li>
            ))}
          </ul>
        </>
      ) : null
    }
    <div class="btn-row history-actions">
      {
        edition.historyPageUrl ? (
          <a class="btn" href={edition.historyPageUrl} data-goal={goals.interestHistory}>
            {historyUi.publishedStory}
          </a>
        ) : null
      }
      <a class="btn btn--ghost" href="/history/" data-goal={goals.interestHistory}>{historyUi.allEditions}</a>
    </div>
    <h2>{historyUi.otherEditions}</h2>
    <ul class="history-others">
      {
        others.map((item) => (
          <li>
            <a href={`/history/${item.slug}/`} data-goal={goals.interestHistory}>
              <span>{item.dateLabel}</span>
              {historyUi.howItWas}
            </a>
          </li>
        ))
      }
    </ul>
    <HistoryNext />
  </div>
</article>

<style>
  .history-edition p,
  .history-edition h1,
  .history-edition h2,
  .history-edition h3,
  .history-edition li {
    overflow-wrap: anywhere;
  }

  .history-date {
    margin: 0 0 1rem;
    color: var(--muted);
    font-weight: 700;
  }

  .history-edition h2 {
    margin-top: 2.25rem;
  }

  .history-stages {
    display: grid;
    gap: 0.35rem 1rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .history-stages li {
    min-width: 0;
    margin: 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
  }

  .history-stages h3 {
    margin: 0 0 0.3rem;
    font-size: 1.15rem;
  }

  .history-stages p {
    margin: 0;
  }

  .history-gallery {
    display: grid;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .history-gallery figure {
    min-width: 0;
    margin: 0;
  }

  .history-gallery img {
    display: block;
    width: 100%;
    border-radius: var(--radius-ui);
    background: var(--surface-muted);
  }

  .history-gallery figcaption {
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .chip-list {
    width: 100%;
  }

  .chip-list .chip {
    max-width: 100%;
    white-space: normal;
  }

  .history-reviews {
    display: grid;
    gap: 1rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .history-reviews li {
    margin: 0;
    padding: 1.1rem 1.15rem 1.15rem;
    border-radius: var(--radius-ui);
    background: var(--surface-muted);
  }

  .history-reviews blockquote {
    margin: 0;
  }

  .history-reviews blockquote p {
    margin: 0;
    color: var(--text-strong);
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    line-height: 1.35;
  }

  .history-review-author {
    margin: 0.9rem 0 0;
    font-weight: 700;
    color: var(--text-strong);
  }

  .history-review-author span {
    font-weight: 500;
    color: var(--muted);
  }

  .history-actions {
    margin-top: 1.75rem;
  }

  .history-actions .btn {
    max-width: 100%;
    white-space: normal;
  }

  .history-others {
    display: grid;
    gap: 0.75rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .history-others a {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    min-height: 2.75rem;
    align-items: center;
    color: var(--text-strong);
    font-weight: 700;
    text-decoration: none;
  }

  .history-others a span {
    font-weight: 600;
  }

  @media (min-width: 800px) {
    .history-gallery--many {
      grid-template-columns: 1fr 1fr;
    }

    .history-gallery--many figure:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
