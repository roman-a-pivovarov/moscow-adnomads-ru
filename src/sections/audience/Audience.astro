---
import { audience } from "./copy";

const tasks = audience.tasks.filter((task) => task.trim().length > 0);
---

<section class="section" id="audience">
  <div class="container audience">
    <h2>{audience.title}</h2>
    {audience.lead.trim() ? <p class="lead">{audience.lead}</p> : null}
    {audience.exchange.trim() ? <p class="exchange">{audience.exchange}</p> : null}
    {
      tasks.length > 0 ? (
        <div class="questions">
          <h3>{audience.tasksTitle}</h3>
          {audience.tasksNote.trim() ? <p class="questions-note">{audience.tasksNote}</p> : null}
          <ul>
            {tasks.map((task) => (
              <li>{task}</li>
            ))}
          </ul>
        </div>
      ) : null
    }
  </div>
</section>

<style>
  .audience {
    min-width: 0;
  }

  .audience > .lead {
    margin-bottom: 0.75rem;
  }

  .exchange {
    max-width: 40rem;
    margin: 0;
  }

  .questions {
    margin-top: 1.75rem;
    padding-top: 1.35rem;
    border-top: 1px solid var(--border);
  }

  .questions h3 {
    margin-bottom: 0.65rem;
  }

  .questions-note {
    max-width: 40rem;
    margin: 0 0 1rem;
  }

  .questions ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem 2rem;
  }

  .questions li {
    min-width: 0;
    margin: 0;
    padding-left: 0.95rem;
    position: relative;
    overflow-wrap: break-word;
    text-wrap: pretty;
  }

  .questions li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 2px;
    background: var(--accent);
  }

  @media (min-width: 900px) {
    .questions ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
    }
  }
</style>
