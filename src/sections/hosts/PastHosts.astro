---
import { pastHostEditions } from "../../content/catalog";
import { pastHosts } from "./copy";

const groups = pastHostEditions();
---

<section class="section" id="past-hosts">
  <div class="container">
    <h2>{pastHosts.title}</h2>
    <div class="host-intro">
      {pastHosts.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    {
      groups.length === 0 ? (
        <p>{pastHosts.empty}</p>
      ) : (
        groups.map(({ edition, hosts }) => (
          <div class="host-group">
            <h3>
              {edition.dateLabel}
              <span>
                {" "}
                · №{edition.adnomadsNumber}
              </span>
            </h3>
            <p class="host-note">
              {edition.hostListStatus === "partial" ? pastHosts.partial : pastHosts.complete}
            </p>
            {
              hosts.length > 0 ? (
                <ul class="chip-list" data-show-more>
                  {hosts.map((host) => (
                    <li class="chip">{host.name}</li>
                  ))}
                </ul>
              ) : null
            }
            {
              hosts.length > 8 ? (
                <button
                  class="btn btn--ghost"
                  type="button"
                  data-show-more-toggle
                  data-label-more={pastHosts.showMore}
                  data-label-less={pastHosts.showLess}
                  aria-expanded="false"
                >
                  {pastHosts.showMore}
                </button>
              ) : null
            }
            <p class="edition-link">
              <a href={`/history/${edition.slug}/`}>{pastHosts.editionLink}</a>
            </p>
          </div>
        ))
      )
    }
  </div>
</section>

<style>
  .host-intro {
    display: grid;
    gap: 0.85rem;
    max-width: 42rem;
    margin-bottom: 1.75rem;
  }

  .host-intro p,
  .host-note,
  .edition-link {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .host-group + .host-group {
    margin-top: 2rem;
  }

  .host-group h3 span {
    color: var(--muted);
    font-weight: 600;
  }

  .host-note {
    margin-bottom: 0.85rem;
  }

  .chip-list {
    width: 100%;
  }

  .chip-list .chip {
    max-width: 100%;
    overflow-wrap: anywhere;
    white-space: normal;
  }

  .host-group .btn {
    margin-top: 0.85rem;
  }

  .edition-link {
    margin-top: 0.85rem;
  }
</style>
