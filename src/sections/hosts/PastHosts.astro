---
import { pastHostEditions } from "../../content/catalog";

const groups = pastHostEditions();
---

<section class="section" id="past-hosts">
  <div class="container">
    <h2>Кто уже принимал группы</h2>
    <p class="lead">
      Ниже — агентства прошлых московских выпусков. Это не список хостов ближайшей программы: его публикуем отдельно, когда встречи подтверждены.
    </p>
    {
      groups.map(({ edition, hosts }) => (
        <div class="host-group">
          <h3>
            {edition.dateLabel}
            <span>
              {" "}
              · №{edition.adnomadsNumber}
            </span>
          </h3>
          {edition.hostListStatus === "partial" ? (
            <p>На публичной карточке выпуска названы эти команды. Полный маршрут там не приведён.</p>
          ) : (
            <p>Принимали группу.</p>
          )}
          <ul class="chip-list" data-show-more>
            {hosts.map((host) => (
              <li class="chip">{host.name}</li>
            ))}
          </ul>
          {hosts.length > 8 ? (
            <button
              class="btn btn--ghost"
              type="button"
              data-show-more-toggle
              data-label-more="Показать ещё"
              data-label-less="Свернуть"
              aria-expanded="false"
            >
              Показать ещё
            </button>
          ) : null}
        </div>
      ))
    }
  </div>
</section>

<style>
  .lead {
    margin-bottom: 1.5rem;
  }

  .host-group + .host-group {
    margin-top: 2rem;
  }

  .host-group h3 span {
    color: var(--muted);
    font-weight: 600;
  }

  .host-group .btn {
    margin-top: 0.85rem;
  }
</style>
