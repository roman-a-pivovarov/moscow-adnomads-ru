---
import { teamMembers } from "../../content/catalog";
import { contacts } from "../../content/contacts";
import { imagesFor } from "../../content/images";
import { teamCopy } from "./copy";

const channels = {
  "person-roman": contacts.roman,
  "person-irina": contacts.irina,
} as const;

const people = teamMembers().flatMap((person) => {
  const profile = teamCopy.people[person.id as keyof typeof teamCopy.people];
  const channel = channels[person.id as keyof typeof channels];
  if (!profile || !channel) {
    return [];
  }
  const portrait = imagesFor("team", undefined, person.id)[0];
  return [{ person, profile, channel, portrait }];
});
---

<section class="section section--muted" id="team">
  <div class="container">
    <h2>{teamCopy.title}</h2>
    <div class="team-intro">
      {
        teamCopy.origin.map((paragraph, index) => (
          <p class:list={[{ "team-intro__secondary": index >= 2 }]}>{paragraph}</p>
        ))
      }
    </div>
    <div class="team-grid">
      {
        people.map(({ person, profile, channel, portrait }) => (
          <article class="person">
            {
              portrait ? (
                <img
                  class="person-photo"
                  src={portrait.src}
                  alt={portrait.alt || person.name}
                  width={portrait.width}
                  height={portrait.height}
                  style={`object-position: ${profile.photoPosition}`}
                />
              ) : null
            }
            <h3>{person.name}</h3>
            <p class="person-role">{profile.role}</p>
            <p class="person-summary">{profile.summary}</p>
            <details class="disclose person__disclose">
              <summary>{profile.discloseLabel}</summary>
              <div class="disclose__body">
                {profile.bio.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </details>
            <div class="person-contacts-desktop">
              <ul class="person-contacts">
                <li><a href={channel.emailHref}>Email</a></li>
                <li><a href={channel.telegramHref}>Telegram</a></li>
                <li><a href={channel.whatsappHref}>WhatsApp</a></li>
              </ul>
            </div>
            <details class="disclose person__disclose person__contact">
              <summary>{profile.contactLabel}</summary>
              <div class="disclose__body">
                <ul class="person-contacts">
                  <li><a href={channel.emailHref}>Email</a></li>
                  <li><a href={channel.telegramHref}>Telegram</a></li>
                  <li><a href={channel.whatsappHref}>WhatsApp</a></li>
                </ul>
              </div>
            </details>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .team-intro {
    display: grid;
    gap: 0.75rem;
  }

  .team-intro p {
    margin: 0;
    max-width: 42rem;
  }

  .team-grid {
    display: grid;
    gap: 2.5rem;
    margin-top: 2.5rem;
  }

  .person {
    min-width: 0;
    margin: 0;
  }

  .person-photo {
    display: block;
    width: 9.25rem;
    height: 9.25rem;
    margin: 0 0 1.15rem;
    object-fit: cover;
    border-radius: 50%;
  }

  .person-role {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-weight: 600;
  }

  .person-summary,
  .person__disclose .disclose__body p {
    margin: 0;
    max-width: none;
  }

  .person__disclose {
    margin-top: 0.75rem;
  }

  .person__disclose .disclose__body {
    padding-top: 0.75rem;
  }

  .person__disclose .disclose__body p + p {
    margin-top: 0.75rem;
  }

  .person-contacts {
    display: grid;
    gap: 0.35rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .person__contact {
    display: none;
  }

  @media (min-width: 720px) {
    .team-grid {
      grid-template-columns: 1fr 1fr;
      column-gap: 2.5rem;
      align-items: start;
    }
  }

  @media (min-width: 768px) {
    .person-photo {
      width: 12.5rem;
      height: 12.5rem;
    }
  }

  @media (max-width: 899px) {
    .team-intro__secondary {
      display: none;
    }

    .person-contacts-desktop {
      display: none;
    }

    .person__contact {
      display: block;
    }

    .person__contact .person-contacts {
      margin-top: 0;
    }
  }
</style>
