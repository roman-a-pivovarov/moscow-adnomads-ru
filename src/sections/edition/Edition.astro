---
import { contacts } from "../../content/contacts";
import { featuredEdition, featuredHasConfirmedHosts, moscowOrdinal } from "../../content/catalog";
import { editionCopy, nextEditionMissing } from "./copy";

const featured = featuredEdition();
const forming = featured && !featuredHasConfirmedHosts();
const days = (featured?.days ?? []).map((day) => ({
  ...day,
  workshop:
    day.label.toLocaleLowerCase("ru").includes("суббот") ||
    day.focus.toLocaleLowerCase("ru").includes("воркшоп"),
}));
const fourDays = days.length === 4;
---

<section class="section" id="edition">
  <div class="container">
    {
      featured ? (
        <>
          <p class="eyebrow">{editionCopy.eyebrow}</p>
          <h2 class="edition-date">{featured.dateLabel}</h2>
          <p class="edition-meta">
            <span>{moscowOrdinal(featured.moscowNumber)} московский выпуск</span>
            <span>ADNOMADS №{featured.adnomadsNumber}</span>
          </p>
          <p class="lead">{fourDays ? editionCopy.structure : featured.summary}</p>
          {fourDays ? <p class="edition-note">{editionCopy.zoom}</p> : null}
          {days.length > 0 ? (
            <ol class="day-list">
              {days.map((day) => (
                <li class:list={{ "is-workshop": day.workshop }}>
                  <h3>{day.label}</h3>
                  <p>{day.focus}</p>
                </li>
              ))}
            </ol>
          ) : null}
          {forming ? <p class="edition-forming">{editionCopy.forming}</p> : null}
          <div class="edition-close">
            <p>{editionCopy.conditions}</p>
            <a class="btn" href="#participate">{contacts.participate.label}</a>
          </div>
        </>
      ) : (
        <>
          <h2>{nextEditionMissing.title}</h2>
          <p class="lead">{nextEditionMissing.text}</p>
          <div class="btn-row">
            <a class="btn" href="#participate">{contacts.participate.label}</a>
            <a class="btn btn--ghost" href="#host">{contacts.host.label}</a>
          </div>
        </>
      )
    }
  </div>
</section>

<style>
  .edition-date {
    max-width: 100%;
    margin-bottom: 0.7rem;
    font-size: clamp(1.95rem, 7.8vw, 2.45rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
    overflow-wrap: normal;
    word-break: normal;
  }

  .edition-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0 0 1.25rem;
    color: var(--muted);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .edition-note {
    max-width: 40rem;
    margin-top: 0.75rem;
  }

  .day-list {
    display: grid;
    gap: 0.75rem;
    margin: 1.5rem 0 2rem;
    padding: 0;
    list-style: none;
  }

  .day-list li {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
    margin: 0;
    padding: 1rem 1.05rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-ui);
    background: var(--bg);
  }

  .day-list li.is-workshop {
    border-color: var(--border-hover);
    background: var(--surface-muted);
  }

  .day-list h3 {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .day-list p {
    margin: 0;
    min-width: 0;
  }

  .edition-close {
    display: grid;
    justify-items: start;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .edition-close p {
    max-width: 40rem;
    margin: 0;
  }

  @media (min-width: 768px) {
    .edition-date {
      font-size: clamp(2.6rem, 4.8vw, 4.125rem);
    }
  }

  @media (min-width: 800px) {
    .edition-meta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.2rem 0.75rem;
    }

    .edition-meta span + span::before {
      content: "·";
      margin-right: 0.55rem;
      color: var(--accent);
    }

    .day-list li {
      grid-template-columns: minmax(11.5rem, 16rem) minmax(0, 1fr);
      gap: 1rem 1.5rem;
      align-items: start;
      padding: 1.05rem 1.2rem;
    }
  }
</style>
